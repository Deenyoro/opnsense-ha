#!/bin/sh
# KC HA: keep forwarding usable the instant this node becomes CARP MASTER, and
# give the CARP BACKUP node internet via the current master.
#
# Why: gateway monitoring (dpinger) can only probe through the CARP VIPs, so on
# the BACKUP node every WAN gateway always reads "down" and OPNsense installs no
# default route (or a LAN one). A takeover would then forward nothing until the
# monitors recover (tens of seconds). We pin the kernel default route to a
# reachable upstream gateway on both roles; OPNsense re-evaluates it as soon as
# the monitors come up and keeps failing over between WANs on its own.
#
# Upstream candidates come from the config: enabled, upstream ("defaultgw"),
# IPv4 gateways ordered by priority (lowest number first). On MASTER the first
# one that answers a ping is used (so a dead primary WAN does not get pinned);
# on BACKUP nothing can be probed, so the first by priority is used - its
# 0/1 + 128/1 routes via the master's VIP take precedence anyway.
# Adding WAN3/WAN4 needs no change here: mark the gateway upstream, give it a
# priority.
#
# BACKUP: additionally route 0/1 + 128/1 via the master's LAN VIP so this
# node's own traffic (updates, CrowdSec, NTP) works; removed on MASTER.
#
# The LAN VIP is the CARP VIP with vhid $VHID (looked up in the config).
# Reads the real CARP role rather than trusting hook arguments. Idempotent.
# Serialised with lockf: one CARP transition fires this once per VIP.
#
# Usage: kc-ha-egress [--dry-run|--show]
VHID=${KC_HA_VHID:-12}
LOCK=/var/run/kc-ha-egress.lock
DRY=0; case "$1" in --dry-run|--show) DRY=1 ;; esac
if [ "$DRY" = 0 ] && [ -z "$KC_HA_LOCKED" ]; then
    KC_HA_LOCKED=1 exec /usr/bin/lockf -t 30 "$LOCK" /bin/sh "$0" "$@"
fi
log() { [ "$DRY" = 1 ] && echo "$*" || /usr/bin/logger -t kc-ha-egress "$*"; }
run() { [ "$DRY" = 1 ] && echo "+ $*" || "$@"; }

eval "$(/usr/local/bin/python3 - "$VHID" <<'PY'
import sys, xml.etree.ElementTree as ET
vhid = sys.argv[1]
r = ET.parse('/conf/config.xml').getroot()
ifmap = {i.tag: (i.findtext('if') or '') for i in r.find('interfaces')}
vip = next((v for v in r.find('virtualip').iter('vip')
            if v.findtext('mode') == 'carp' and v.findtext('vhid') == vhid), None)
print('VIP=%s' % (vip.findtext('subnet') if vip is not None else ''))
print('IF=%s' % (ifmap.get(vip.findtext('interface'), '') if vip is not None else ''))
gws = []
for it in r.find('OPNsense/Gateways').iter('gateway_item'):
    g = lambda k, d='': (it.findtext(k) or d)
    if g('disabled', '0') == '1' or g('force_down', '0') == '1' or g('defaultgw', '0') != '1':
        continue
    if g('ipprotocol', 'inet') != 'inet' or not g('gateway') or g('gateway') == 'dynamic':
        continue
    gws.append((int(g('priority', '255') or 255), g('gateway'), g('name')))
gws.sort()
print('GWS="%s"' % ' '.join(x[1] for x in gws))
PY
)"
if [ -z "$VIP" ] || [ -z "$IF" ]; then
    log "no CARP VIP with vhid $VHID in config; nothing to do"; exit 0
fi

role=$(/sbin/ifconfig "$IF" 2>/dev/null | awk -v v="vhid $VHID" '$0 ~ "carp: [A-Z]+ " v {print $2; exit}')
have=$(/usr/bin/netstat -rn -f inet | awk '$1=="0.0.0.0/1"||$1=="128.0.0.0/1"' | wc -l | tr -d ' ')
curdef=${KC_HA_TEST_DEF-$(/usr/bin/netstat -rn -f inet | awk '$1=="default"{print $2; exit}')}   # KC_HA_TEST_DEF: test hook for --dry-run
if [ "$1" = "--show" ]; then
    echo "role=$role vip=$VIP if=$IF vhid=$VHID egress_routes=$have default=${curdef:-none} upstream_by_priority=[$GWS]"
    for gw in $GWS; do /sbin/ping -q -c 1 -W 700 "$gw" >/dev/null 2>&1 && echo "  $gw answers ping" || echo "  $gw no ping reply"; done
    exit 0
fi

case "$role" in
    BACKUP)
        if [ "$have" != 2 ]; then
            run /sbin/route -q delete -net 0.0.0.0/1 >/dev/null 2>&1
            run /sbin/route -q delete -net 128.0.0.0/1 >/dev/null 2>&1
            run /sbin/route -q add -net 0.0.0.0/1 "$VIP" && run /sbin/route -q add -net 128.0.0.0/1 "$VIP"
            log "BACKUP: egress via $VIP installed"
        fi ;;
    *)
        if [ "$have" != 0 ]; then
            run /sbin/route -q delete -net 0.0.0.0/1 >/dev/null 2>&1
            run /sbin/route -q delete -net 128.0.0.0/1 >/dev/null 2>&1
            log "${role:-no-carp}: egress routes removed"
        fi ;;
esac

# Default route missing or pointing into a LAN: pin it to an upstream gateway.
case "$curdef" in
    ""|10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*|169.254.*)
        pick=""
        if [ "$role" = MASTER ]; then
            for gw in $GWS; do
                if /sbin/ping -q -c 1 -W 700 "$gw" >/dev/null 2>&1 || /sbin/ping -q -c 1 -W 700 "$gw" >/dev/null 2>&1; then
                    pick=$gw; break
                fi
            done
            [ -z "$pick" ] && log "MASTER: no upstream gateway answered ping, using first by priority"
        fi
        [ -z "$pick" ] && pick=${GWS%% *}
        if [ -n "$pick" ]; then
            run /sbin/route -q delete default >/dev/null 2>&1
            run /sbin/route -q add default "$pick" >/dev/null 2>&1
            log "${role:-no-carp}: default route was '${curdef:-none}', pinned to $pick"
        fi ;;
esac
exit 0
